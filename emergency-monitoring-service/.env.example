# Copy this file to .env and fill in real values.

# Shared PostgreSQL database (same DB the Node.js backend uses).
# For local dev without Postgres set up yet, leave unset and the
# service will fall back to a local SQLite file (dev.db).
DATABASE_URL=postgresql://user:password@localhost:5432/guidelanka

# Path to the Firebase service account JSON (Console > Project Settings
# > Service Accounts > Generate new private key). If unset, alerts are
# logged locally instead of pushed via FCM -- useful for dev/testing.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FCM_ALERT_TOPIC=park-authority-alerts

# Detection thresholds (FR9 / FR10)
STATIONARY_THRESHOLD_MINUTES=10
STATIONARY_RADIUS_METERS=15
DEVIATION_THRESHOLD_METERS=200

# How often the background sweep checks for stationary vehicles
SWEEP_INTERVAL_MINUTES=1
